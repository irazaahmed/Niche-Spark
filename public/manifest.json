{
  "manifest_version": 3,
  "name": "NicheSpark",
  "short_name": "NicheSpark",
  "version": "0.3.1",
  "description": "Discover Keywords. Uncover Opportunities. Collect Google Autocomplete suggestions for SEO niche research.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NicheSpark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.co.uk/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*",
    "https://www.google.co.in/*",
    "https://www.google.com.pk/*",
    "https://www.google.ie/*",
    "https://www.google.co.nz/*",
    "https://www.google.co.za/*",
    "https://www.google.com.sg/*",
    "https://www.google.ae/*",
    "https://www.google.de/*",
    "https://www.google.fr/*",
    "https://www.google.es/*",
    "https://www.google.it/*",
    "https://www.google.nl/*",
    "https://www.google.com.br/*",
    "https://www.google.com.mx/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.google.co.in/*",
        "https://www.google.com.pk/*",
        "https://www.google.ie/*",
        "https://www.google.co.nz/*",
        "https://www.google.co.za/*",
        "https://www.google.com.sg/*",
        "https://www.google.ae/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.es/*",
        "https://www.google.it/*",
        "https://www.google.nl/*",
        "https://www.google.com.br/*",
        "https://www.google.com.mx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
